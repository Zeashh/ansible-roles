#!/bin/bash

_wireguard_container={{ keepalived_wireguard_container }}
_headscale_health_url={{ keepalived_headscale_health_url }}

# Switch to BACKUP VRRP mode if any of these are true:
# - HAProxy isn't running
# - Headscale and $wireguard_container aren't running

if ! systemctl is-active --quiet haproxy; then exit 1; fi
if [ "$(docker inspect -f '{{ '{{' }}.State.Running{{ '}}' }}' "$_wireguard_container" 2>/dev/null)" != "true" ] \
    && ! curl -f $_headscale_health_url \
    ; then exit 1; fi
