global_defs {
    enable_script_security
    script_user root
}

vrrp_script check_script {
    script "{{ keepalived_check_script_dest }}"
    interval {{ keepalived_check_script_interval }}
    fall {{ keepalived_check_script_fall }}
    rise {{ keepalived_check_script_rise }}
}

vrrp_instance {{ ansible_facts['hostname'] }} {
    state BACKUP
    interface {{ keepalived_int }}
    virtual_router_id {{ keepalived_vr_id }}
    priority {{ keepalived_master_priority - (groups[keepalived_group] | sort).index(inventory_hostname) }}
    advert_int {{ keepalived_advert_int }}

    unicast_src_ip {{ ansible_facts['default_ipv4']['address'] }}
    unicast_peer {
        {% for host in groups[keepalived_group] if host != inventory_hostname %}
        {{ hostvars[host]['ansible_facts']['default_ipv4']['address'] }}
        {% endfor %}
    }
    virtual_ipaddress {
        {% for a in keepalived_vrrp_addresses | sort %}
        {{ a }}
        {% endfor %}
    }

    track_script {
        check_script
    }

    notify {{ keepalived_notify_script_dest }}
}
