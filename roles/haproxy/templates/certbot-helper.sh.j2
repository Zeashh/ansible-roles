#!/bin/bash

_certbot_email="{{ certbot_email }}"
_cloudflare_credentials_file=/root/secrets/cloudflare.ini

if [[ $UID != 0 ]]; then
    echo This script must be run as root!
    exit 1
fi

read -p "Enter comma-separated list of domains to get a certificate for: " _cert_domain

certbot certonly \
    --non-interactive \
    --agree-tos \
    --email $_certbot_email \
    --preferred-challenges dns \
    --dns-cloudflare \
    --dns-cloudflare-credentials $_cloudflare_credentials_file \
    --dns-cloudflare-propagation-seconds 300 \
    --keep-until-expiring \
    -d $_cert_domain

printf "\n"
ls -l /etc/letsencrypt/live
printf "\n"
read -p "Enter certificate directory name: " _cert_dir
cd /etc/letsencrypt/live/$_cert_dir
cat fullchain.pem privkey.pem > /etc/haproxy/certificates/$_cert_dir.pem

systemctl reload haproxy
