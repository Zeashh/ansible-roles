#!/bin/bash

exec 1> >(logger -s -t $(basename $0)) 2>&1

if [[ $UID != 0 ]]; then
    echo This script must be run as root!
    exit 1
fi

cert_tmp_dir=/root/tmp/old_haproxy_certs
domain={{ headscale_domain }}
cert_src_dir=/etc/letsencrypt/live/$domain
cert_dest_dir={{ headscale_cert_destination_path }}

# Move existing certificates to a temporary directory
mkdir -p $cert_tmp_dir
cp $cert_dest_dir/fullchain.pem $cert_dest_dir/privkey.pem $cert_tmp_dir/

# Apply new certificates
cp $cert_src_dir/fullchain.pem $cert_src_dir/privkey.pem $cert_dest_dir
chown -R headscale:headscale $cert_dest_dir

systemctl restart headscale

if [[ $? == 0 ]]; then
    rm -rf $cert_tmp_dir/
fi
